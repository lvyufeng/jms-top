/* jms-top — nvitop's density, a fleet's worth of hosts.

   Layout, top to bottom:
     title bar    fleet identity, connection and poll state, summary counters
     body         the host table (flex) | the cards panel for the selected host
     detail       open-slot info for the selected host: cards, processes, health
     footer       keys and the activity log tail

   Colours are used for one job only: state. free=green, partial=yellow,
   busy=red, residual=orange, unknown=magenta (never green), down=dim. A row's
   colour is its verdict, so "is anything free" is answerable from arm's length.

   Two background colours, and every panel uses one of them whole-width, so no
   seam between two panels can be mistaken for a bar:

     $table-pad   the frame: bars, the command bar, the pane around the table
     $row-bg      the fleet table and the side panel beside it

   $panel (a bluish grey) and $surface (a third grey) are deliberately not used as
   backgrounds, and Textual's default zebra striping is switched off -- both were
   responsible for rows that changed colour part-way across.
*/

$table-pad: #1E1E1E;

/* The fleet table's own background. The table paints its rows across the full width
   of its widget, so this is the colour every row sits on; the side panel next to it
   has to use the same one, and the frame around both is $table-pad. Change these two
   together or the seam between the table and the panel re-appears as a grey band. */
$row-bg: #272727;

Screen {
    background: $table-pad;
}

#titlebar {
    height: 1;
    background: $table-pad;
    color: $text;
    padding: 0 1;
}

#titlebar.explore {
    background: $warning-darken-2;
    color: $text;
}

#body {
    height: 1fr;
}

#fleet-pane {
    width: 1fr;
    height: 1fr;
    background: $table-pad;
}

#table {
    height: 1fr;
    background: $row-bg;
    scrollbar-size-vertical: 1;
}

/* Zebra striping is off in the widget (it was the darker-than-the-panel half of a
   row being two colours). The two classes stay painted in the table's own colour so
   a later edit cannot turn the striping back on by accident.
   No background-tint either: Textual tints a focused DataTable by 5%, which made
   every row of ours a shade lighter than the panel next to it. */
#table > .datatable--even-row,
#table > .datatable--odd-row {
    background: $row-bg;
}

#table:focus {
    background-tint: $row-bg 0%;
}

#table:focus > .datatable--even-row,
#table:focus > .datatable--odd-row {
    background: $row-bg;
    background-tint: $row-bg 0%;
}

#table > .datatable--header {
    background: $panel;
    color: $text-muted;
    text-style: bold;
}

#table > .datatable--cursor {
    background: $accent 40%;
    color: $text;
}

#table > .datatable--hover {
    background: $accent 20%;
}

#side {
    width: 46;
    height: 1fr;
    background: $row-bg;
    padding: 0 1;
}

#side-title {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#cards {
    height: auto;
    background: $row-bg;
}

#detail {
    height: auto;
    max-height: 14;
    background: $row-bg;
    padding: 0 1;
}

#footer-bar {
    height: 1;
    background: $table-pad;
    color: $text-muted;
    padding: 0 1;
}

.hidden {
    display: none;
}

/* The command bar replaces the footer while typing a filter. */
#command {
    height: 3;
    background: $table-pad;
    padding: 0 1;
}

#command.hidden {
    display: none;
}