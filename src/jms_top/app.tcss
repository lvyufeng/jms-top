/* jms-top — nvitop's density, a fleet's worth of hosts.

   Layout, top to bottom:
     title bar    fleet identity, connection and poll state, summary counters
     body         the host table (flex) | the cards panel for the selected host
     detail       open-slot info for the selected host: cards, processes, health
     footer       keys and the activity log tail

   Colours are used for one job only: state. free=green, partial=yellow,
   busy=red, residual=orange, unknown=magenta (never green), down=dim. A row's
   colour is its verdict, so "is anything free" is answerable from arm's length.

   One colour for the whole frame: the bars, the table, the pane it sits in and the
   side panel are all $table-pad. Nothing shows as a band across the screen except
   the rows that mean something -- the column header, the cursor row, the zebra
   striping. $panel (a bluish grey) and $surface (a third grey) are deliberately
   not used as backgrounds: anywhere one of them met a panel that used the other,
   the seam read as a grey bar.
*/

$table-pad: #1E1E1E;

Screen {
    background: $table-pad;
}

#titlebar {
    height: 1;
    background: $table-pad;
    color: $text;
    padding: 0 1;
}

#titlebar.explore {
    background: $warning-darken-2;
    color: $text;
}

#body {
    height: 1fr;
}

#fleet-pane {
    width: 1fr;
    height: 1fr;
    background: $table-pad;
}

#table {
    height: 1fr;
    background: $table-pad;
    scrollbar-size-vertical: 1;
}

#table > .datatable--header {
    background: $panel;
    color: $text-muted;
    text-style: bold;
}

#table > .datatable--cursor {
    background: $accent 40%;
    color: $text;
}

#table > .datatable--hover {
    background: $accent 20%;
}

#side {
    width: 46;
    height: 1fr;
    background: $table-pad;
    padding: 0 1;
}

#side-title {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#cards {
    height: auto;
    background: $table-pad;
}

#detail {
    height: auto;
    max-height: 14;
    background: $boost;
    padding: 0 1;
}

#footer-bar {
    height: 1;
    background: $table-pad;
    color: $text-muted;
    padding: 0 1;
}

.hidden {
    display: none;
}

/* The command bar replaces the footer while typing a filter. */
#command {
    height: 3;
    background: $table-pad;
    padding: 0 1;
}

#command.hidden {
    display: none;
}